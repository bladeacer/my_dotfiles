{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "options" : {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "HEADROOM_TELEMETRY=off HEADROOM_CODE_AWARE_ENABLED=1 headroom proxy --code-graph --memory & sleep 2 && headroom mcp serve"
      ],
      "enabled": true
    },
    "lccst": {
      "type": "local",
      "command": [
        "node",
        "/home/data/Desktop/projects/lccst/dist/index.js"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "opencode-omniroute-auth"
  ]
}
